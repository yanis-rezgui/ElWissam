generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

enum Role {
  ADMIN
  USER
}

enum StatutBien {
  DISPONIBLE
  RESERVE
  VENDU
  LOUE
}

enum TypeBien {
  APPARTEMENT
  TERRAIN
  LOCAL
  VILLA
}

enum ServiceBien {
  LOCATION
  VENTE
}

enum StatutDemande {
  EN_ATTENTE
  CONTACTE
  VISITE_CONFIRMEE
  TERMINEE
  ANNULEE
}

model User {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetToken   String?
  passwordResetExpires DateTime?

  favoris       Bien[]
  notifications Notification[]
}

model Bien {
  id          String      @id @default(uuid())

  nom         String
  description String

  prix        Float
  negociable  Boolean     @default(false)

  statut      StatutBien  @default(DISPONIBLE)

  localisation String
  superficie   Float

  type        TypeBien
  service     ServiceBien

  features    String[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  localisationMap String?



  images      BienImage[]
  demandes    DemandeVisite[]

  favoriPar User[]

  @@index([statut])
  @@index([type])
  @@index([service])
  @@index([localisation])
}

model BienImage {
  id        String   @id @default(uuid())

  url       String
  publicId  String

  bienId    String
  bien      Bien     @relation(fields: [bienId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([bienId])
}


model DemandeVisite {
  id             String          @id @default(uuid())
  nom            String
  email          String
  telephone      String

  dateSouhaitee  DateTime
  message        String?

  statut         StatutDemande   @default(EN_ATTENTE)

  bienId         String
  bien           Bien            @relation(fields: [bienId], references: [id], onDelete: Cascade)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([bienId])
  @@index([statut])
}

model Testimonial {
    id        String   @id @default(cuid())
    fullName  String
    message   String
    rating    Float
    active    Boolean  @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}


model Agency {
  id          Int      @id @default(1)
  name        String
  phone       String[]
  email       String?
  address     String
  mapsUrl     String?

  socialLinks Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum NotificationType {
  NEW_VISITE
  NEW_USER
  NEW_BIEN
  STATUS_CHANGED
  NEW_TESTIMONIAL
  SECURITY
}

model Notification {
  id        String           @id @default(uuid())

  title     String
  message   String
  type      NotificationType

  read      Boolean          @default(false)

  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}


model Commune {
  id            String   @id @default(uuid())
  name          String
  imageUrl      String?
  imagePublicId String?

  active        Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
  
}